# Copy to .env and set real values before `docker compose up -d`.
# Used by compose to render config/gns3_server.conf at container start.
#
# After changing values run `docker compose up -d` — a plain
# `docker compose restart` keeps the old values (the container env is frozen
# at creation). `config/gns3_server.conf` is regenerated on every start;
# don't hand-edit it.
GNS3_USER=gns3
GNS3_PASSWORD=change-me
